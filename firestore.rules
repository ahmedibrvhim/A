rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin check: case-insensitive email compare, works for Google & email/password
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'amedsaad036@gmail.com';
    }
    function signedIn() { return request.auth != null; }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /orders/{orderId} {
      allow create: if signedIn();
      allow get, list: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /driveFiles/{fileKey} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteStats/{doc} {
      allow read, write: if true;
    }

    match /ratings/{docId} {
      allow read: if true;
      allow create, update: if signedIn() && (docId == request.auth.uid || docId == '_aggregate');
      allow delete: if isAdmin();
    }

    match /appState/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blockedUsers/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /screenshotStrikes/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.count >= resource.data.count;
      allow delete: if isAdmin();
    }
  }
}
